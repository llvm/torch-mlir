package(
    default_visibility = [
        "//visibility:public",
    ],
)

# Python sources in torch_mlir/extras (the FX and ONNX importers) for
# downstream projects that ship them in their own Python package, e.g. IREE's
# iree.compiler.extras.
filegroup(
    name = "TorchExtrasPyFiles",
    srcs = glob(["torch_mlir/extras/*.py"]),
)
